# --- Reverse proxy ---------------------------------------------------------

# Site address Caddy serves. Two modes:
#   • Real domain (e.g. cutline.example.com) → automatic HTTPS via Let's Encrypt.
#     Requires the domain's A/AAAA records to point at this server, and ports
#     80 + 443 to be reachable from the public internet.
#   • Leave commented out (defaults to ":80") → HTTP only on port 80. Use this
#     for local docker-compose or when you have your own TLS terminator in front.
# CUTLINE_DOMAIN=cutline.example.com

# --- Postgres --------------------------------------------------------------

POSTGRES_USER=cutline
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=cutline

# --- Backend ---------------------------------------------------------------

# Required to call any /api/admin/* endpoint. Use a long random string.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me-please-use-openssl-rand-hex-32

# JSON-encoded list of allowed origins for CORS. With the bundled Caddy
# reverse proxy, the frontend and API share an origin so this can stay
# narrow. Add origins here only if you serve the frontend elsewhere.
# Example: CORS_ORIGINS=["https://cutline.example.com"]
CORS_ORIGINS=["http://localhost"]

GAME_NAME=Cutline

# --- Frontend (build-time) -------------------------------------------------

# Baked into the JS bundle. Default empty → the browser fetches relative
# paths (e.g. /api/puzzle/today), which Caddy routes to the backend.
# Only set this to an absolute URL if the frontend is served from a
# different origin than the API. Changing this requires
#   docker compose build frontend
NEXT_PUBLIC_API_BASE=
